<% content_for :title, "Collection" %>

<section class="hero">
  <h1>Collection</h1>
  <p class="muted">Catalogue the video games, board games, and books you own, and share them with whomever you like.</p>

  <p class="hero__actions">
    <% if user_signed_in? %>
      <%= link_to "My collection", profile_path(current_user.username), class: "button" %>
      <%= link_to "All collections", collections_path, class: "button button--ghost" %>
    <% else %>
      <%= link_to "Get started", new_user_registration_path, class: "button" %>
      <%= link_to "Log in", new_user_session_path, class: "button button--ghost" %>
    <% end %>
  </p>
</section>

<% if user_signed_in? %>
  <% if @newest_collectible %>
    <section class="section">
      <h2>From your collection</h2>
      <div class="grid">
        <div class="highlight">
          <p class="muted">Newest addition</p>
          <%= render "collectibles/collectible",
                collectible: @newest_collectible, username: current_user.username, link_keys: @link_keys %>
        </div>
        <% if @random_collectible %>
          <div class="highlight">
            <p class="muted">Random pick</p>
            <%= render "collectibles/collectible",
                  collectible: @random_collectible, username: current_user.username, link_keys: @link_keys %>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="section">
    <h2>Collections you follow</h2>
    <%= render "root/collection_list", collections: @followed,
          empty: "You’re not following any collections yet." %>
  </section>

  <section class="section">
    <h2>Private collections shared with you</h2>
    <%= render "root/collection_list", collections: @shared,
          empty: "No private collections have been shared with you." %>
  </section>
<% end %>

<section class="section">
  <h2>Recently updated collections</h2>
  <%= render "root/collection_list", collections: @recent,
        empty: "No collections have been updated recently.", show_tags: true %>
</section>
