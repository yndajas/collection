<% owner_label = @owner ? "My collection" : "#{@profile.name}’s collection" %>
<% content_for :title, "#{@collectible.title} · #{owner_label}" %>

<nav class="breadcrumb muted">
  <%= link_to owner_label, profile_path(@profile.username, token: @token) %>
  <span aria-hidden="true">/</span>
  <span><%= @collectible.title %></span>
</nav>

<div class="page-head">
  <div>
    <span class="card__type"><%= @collectible.type_label %></span>
    <h1><%= @collectible.title %></h1>
    <% if (subtitle = collectible_subtitle(@collectible)) %>
      <p class="muted"><%= subtitle %></p>
    <% end %>
  </div>
  <% if @owner %>
    <div class="page-head__actions">
      <%= link_to "Edit", edit_profile_collectible_path(@profile.username, @collectible), class: "button" %>
      <%= link_to "Delete", confirm_delete_profile_collectible_path(@profile.username, @collectible), class: "button button--danger" %>
    </div>
  <% end %>
</div>

<% if collectible_traits(@collectible).any? %>
  <p class="tags">
    <% collectible_traits(@collectible).each do |trait| %>
      <span class="tag"><%= trait %></span>
    <% end %>
  </p>
<% end %>

<% if @collectible.labels.any? %>
  <p class="tags">
    <% @collectible.labels.ordered.each { |label| %><%= label_tag_span(label) %><% } %>
  </p>
<% end %>

<% if @collectible.notes.present? %>
  <section class="section">
    <h2>Notes</h2>
    <p><%= simple_format @collectible.notes %></p>
  </section>
<% end %>

<% links = @collectible.search_links(only: @link_keys) %>
<% if links.any? %>
  <section class="section">
    <h2>Look it up</h2>
    <p class="tags">
      <% links.each do |link| %>
        <%= link_to link[:name], link[:url], class: "tag tag--link", target: "_blank", rel: "noopener" %>
      <% end %>
    </p>
  </section>
<% end %>

<p>
  <%= link_to "← Back to #{@owner ? "my collection" : "#{@profile.name}’s collection"}",
        profile_path(@profile.username, token: @token) %>
</p>
