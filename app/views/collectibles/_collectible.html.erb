<%# locals: (collectible:, username:, link_keys: nil, token: nil) %>
<%# link_keys: nil shows all applicable links; an array restricts to those keys %>
<article class="card">
  <div class="card__body">
    <span class="card__type"><%= collectible.type_label %></span>
    <h3 class="card__title">
      <%= link_to collectible.title, profile_collectible_path(username, collectible, token: token) %>
    </h3>

    <% if (subtitle = collectible_subtitle(collectible)) %>
      <p class="card__subtitle"><%= subtitle %></p>
    <% end %>

    <% if collectible_traits(collectible).any? %>
      <p class="tags">
        <% collectible_traits(collectible).each do |trait| %>
          <span class="tag"><%= trait %></span>
        <% end %>
      </p>
    <% end %>

    <% if collectible.labels.any? %>
      <p class="pills">
        <% collectible.labels.ordered.each { |label| %><%= label_pill(label) %><% } %>
      </p>
    <% end %>

    <% links = collectible.search_links(only: link_keys) %>
    <% if links.any? %>
      <p class="links">
        <% links.each do |link| %>
          <%= link_to link[:name], link[:url], class: "chip chip--small", target: "_blank", rel: "noopener" %>
        <% end %>
      </p>
    <% end %>
  </div>
</article>
